# Rendered by `just render-units` from config/gnomehome.toml. Edit the config, not this file.
[Unit]
Description=GnomeHome router syslog ingest (DHCP inventory, new-device and drift alerts)

[Service]
Type=oneshot
User=${user}
Group=${user}
Environment=GNOMEHOME_CONFIG=${config_file}
ExecStart=${install_dir}/.venv/bin/gnomehome syslog
TimeoutStartSec=5min
# Reads a local file only: no network at all, and no capabilities.
PrivateNetwork=yes
IPAddressDeny=any
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=${writable}
ReadOnlyPaths=${readonly} ${router_syslog_dir}
${hardening}
