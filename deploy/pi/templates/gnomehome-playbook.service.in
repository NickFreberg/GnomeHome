# Rendered by `just render-units` from config/gnomehome.toml. Edit the config, not this file.
[Unit]
Description=GnomeHome playbook engine (automated Blue Team): new incidents, approvals, expiries

[Service]
Type=oneshot
User=${user}
Group=${user}
Environment=GNOMEHOME_CONFIG=${config_file}
ExecStart=${install_dir}/bin/gnomehome-playbook run
TimeoutStartSec=5min
# Reaches Pi-hole's API on this machine and, through the Python helper, the router's
# SSH. Nothing else. Dry run unless [response] says otherwise.
IPAddressAllow=localhost ${router_ip}
IPAddressDeny=any
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=${writable}
ReadOnlyPaths=${readonly}
${hardening}
