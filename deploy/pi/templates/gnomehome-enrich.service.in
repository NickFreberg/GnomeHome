# Rendered by `just render-units` from config/gnomehome.toml. Edit the config, not this file.
[Unit]
Description=GnomeHome vulnerability enrichment (NVD, EPSS, KEV) and daily risk scores
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=${user}
Group=${user}
Environment=GNOMEHOME_CONFIG=${config_file}
# The leading "-" lets scoring run even if a feed was unreachable; enrich logs the problem.
ExecStart=-${install_dir}/.venv/bin/gnomehome enrich
ExecStart=${install_dir}/.venv/bin/gnomehome score
TimeoutStartSec=1h
# Talks to NVD, FIRST, and CISA over HTTPS; needs no capabilities.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=${writable}
ReadOnlyPaths=${readonly}
${hardening}
